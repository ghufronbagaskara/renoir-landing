---
export const prerender = true;
import type { GetStaticPaths } from "astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Img from "~/components/ui/Img.astro";
import BlogSidebar from "~/components/sections/blog/BlogSidebar.astro";
import { formatDate, getPosts } from "~/lib/content";

export const getStaticPaths = (async ({ paginate }) => paginate(await getPosts(), { pageSize: 3 })) satisfies GetStaticPaths;

const { page } = Astro.props;
const pages = Array.from({ length: page.lastPage }, (_, i) => i + 1);
const hrefFor = (n: number) => (n === 1 ? "/blog/" : `/blog/${n}/`);
---
<BaseLayout
  title={page.currentPage === 1 ? "Our Blog" : `Our Blog - Page ${page.currentPage}`}
  breadcrumb={{ title: "Our Blog" }}
>
  <section class="si-blog-standard-area">
    <div class="container container-1617">
      <div class="row">
        <div class="col-lg-8">
          {
            page.data.map((post, i) => (
              <article class="si-blog-standard-box">
                <div class="si-blog-standard-thumb">
                  <Img src={post.data.listImage} alt={post.data.title} loading={i === 0 ? "eager" : "lazy"} />
                </div>
                <div class="si-blog-standard-text">
                  <span>{post.data.category}</span>
                  <span>{formatDate(post.data.date)}</span>
                  <span>by {post.data.author}</span>
                  <h2 class="h3">
                    <a class="underline-black" href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </h2>
                </div>
                <div class="si-blog-standard-btn">
                  <a class="si-btn-one" href={`/blog/${post.id}/`} aria-label={`View details: ${post.data.title}`}> <span class="btn-text"> <span>View Details</span> </span> <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></a>
                </div>
              </article>
            ))
          }
          {
            page.lastPage > 1 && (
              <nav class="si-blog-standard-number" aria-label="Pagination">
                <ul>
                  {pages.map((n) => (
                    <li>
                      <a href={hrefFor(n)} aria-current={n === page.currentPage ? "page" : undefined}>{String(n).padStart(2, "0")}</a>
                    </li>
                  ))}
                  {page.url.next && (
                    <li>
                      <a href={page.url.next} aria-label="Next page"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                    </li>
                  )}
                </ul>
              </nav>
            )
          }
        </div>
        <div class="col-lg-4">
          <BlogSidebar />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
