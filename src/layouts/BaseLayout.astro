---
import "bootstrap/dist/css/bootstrap.min.css";
import "@fontsource-variable/inter/wght.css";
import "~/styles/global.scss";
import HeaderHome from "~/components/layout/HeaderHome.astro";
import HeaderInner from "~/components/layout/HeaderInner.astro";
import Offcanvas from "~/components/layout/Offcanvas.astro";
import SearchOverlay from "~/components/layout/SearchOverlay.astro";
import Footer from "~/components/layout/Footer.astro";
import Breadcrumb, { type Crumb } from "~/components/layout/Breadcrumb.astro";
import { langTag, ogLocale, path, t, type Alternates, type Locale } from "~/i18n";
import { abs, graph, organization, webPage, website, type JsonLd, type PageMeta } from "~/lib/seo";
// Preloaded so the hero heading doesn't reflow when the web font swaps in (CLS). Body text (Inter)
// uses a metric-matched fallback instead (see utils/_typography.scss), so it needs no preload.
import headingFont from "~/assets/fonts/GeneralSans-Semibold.woff2?url";

interface Props {
  locale: Locale;
  /** Full <title> text (already includes "Renoir"). */
  title: string;
  description: string;
  /** URLs of this page in each language that has it (drives hreflang + the language switch). */
  alternates: Alternates;
  /** Home uses the transparent header + home footer variant; every other page the inner ones. */
  home?: boolean;
  /** Give pages without a dark breadcrumb hero a readable dark header. */
  solidHeader?: boolean;
  /** Renders the template breadcrumb hero; omit on home. */
  breadcrumb?: Crumb;
  /** Keeps the page out of search engines and the site search index (404). */
  noindex?: boolean;
  /** Include a noindex page in Pagefind when a preview needs internal search. */
  searchable?: boolean;
  /** Project-specific Open Graph image path. */
  ogImage?: string;
  /** schema.org WebPage subtype. */
  pageType?: PageMeta["type"];
  /** Extra JSON-LD nodes (Service, FAQPage, Article…). */
  schema?: JsonLd[];
  ogType?: "website" | "article";
}
const { locale, title, description, alternates, home = false, solidHeader = false, breadcrumb, noindex = false, searchable = !noindex, pageType, schema = [], ogType = "website", ogImage: ogImagePath = `/og/renoir-${locale}.jpg` } = Astro.props;

const pathname = Astro.url.pathname;
const canonical = abs(pathname);
const ogImage = abs(ogImagePath);
const crumbs = breadcrumb
  ? [...(breadcrumb.parent ? [{ name: breadcrumb.parent.label, url: breadcrumb.parent.href }] : []), { name: breadcrumb.title, url: pathname }]
  : undefined;
const jsonLd = graph([
  organization(locale),
  website(),
  ...webPage({ locale, url: pathname, title, description, breadcrumb: crumbs, type: pageType }),
  ...schema,
]);
const c = t(locale);
---
<!doctype html>
<html lang={langTag[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <>
          <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
          <link rel="canonical" href={canonical} />
          {Object.entries(alternates).map(([l, href]) => (
            <link rel="alternate" hreflang={langTag[l as Locale]} href={abs(href!)} />
          ))}
          {alternates.en && <link rel="alternate" hreflang="x-default" href={abs(alternates.en)} />}
        </>
      )
    }
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={c.site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {Object.keys(alternates).filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocale[l as Locale]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <div id="magic-cursor" class="cursor-black-bg" aria-hidden="true">
      <div id="ball"></div>
    </div>

    <a class="floating-contact" href={pathname === path("contact", locale) ? "#project-form" : path("contact", locale)}>
      <span class="floating-contact-long">{c.nav.floatingCta}</span><span class="floating-contact-short">{c.nav.floatingCtaShort}</span><i class="fa-sharp fa-regular fa-arrow-up-right" aria-hidden="true"></i>
    </a>

    {home ? <HeaderHome locale={locale} alternates={alternates} /> : <HeaderInner locale={locale} alternates={alternates} solid={solidHeader} />}
    <Offcanvas locale={locale} alternates={alternates} />
    <SearchOverlay locale={locale} />

    <main id="main" data-pagefind-body={searchable ? "" : undefined} data-pagefind-ignore={searchable ? undefined : ""}>
      {breadcrumb && <Breadcrumb {...breadcrumb} locale={locale} />}
      <slot />
    </main>

    <Footer locale={locale} home={home} />

    <script>
      import "~/scripts/site";
      import "~/scripts/anim";
      import "~/scripts/cursor";
    </script>
  </body>
</html>
