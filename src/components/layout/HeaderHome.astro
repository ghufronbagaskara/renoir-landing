---
import Img from "~/components/ui/Img.astro";
import NavMenu from "./NavMenu.astro";
---
<header id="header-sticky" class="si-header-area header-transparent" data-sticky-class="header-sticky">
  <div class="container container-1748">
    <div class="row align-items-center">
      <div class="col-xl-2 col-lg-6 col-6">
        <div class="si-header-logo">
          <a href="/" aria-label="Averix home">
            <Img class="logo-black" style="width:167px" src="logo/logo-black.png" alt="Averix" loading="eager" />
          </a>
        </div>
      </div>
      <div class="col-xl-10 col-lg-6 col-6">
        <div class="si-header-main">
          <div class="si-header-main2">
            <div class="si-header-right">
              <div class="si-header-box d-none d-xl-block">
                <div class="si-header-menu si-header-dropdown dropdown-white-bg">
                  <nav class="si-mobile-menu-active" aria-label="Main">
                    <NavMenu />
                  </nav>
                </div>
              </div>
              <div class="si-header-bar">
                <button class="si-offcanvas-open-btn" type="button" aria-label="Open menu" aria-controls="offcanvas" aria-expanded="false">
                  <span>
                    <Img src="header/close.svg" alt="" />
                  </span>
                </button>
              </div>
              <div class="si-header-btn">
                <a class="si-btn-one" href="/contact/"> <span class="btn-text"> <span>Let's Talk</span> </span> <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
