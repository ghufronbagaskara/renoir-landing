---
import NavMenu from "./NavMenu.astro";
import LangSwitch from "./LangSwitch.astro";
import BrandMark from "~/components/ui/BrandMark.astro";
import { path, t, type Alternates, type Locale } from "~/i18n";
interface Props { locale: Locale; alternates: Alternates; inner?: boolean; solid?: boolean }
const { locale, alternates, inner = false, solid = false } = Astro.props;
const c = t(locale);
---
<header id={inner ? "header-sticky-black" : "header-sticky"} class:list={["si-header-area home-header", { "inner-header": inner, "renoir-solid-header": solid }]} data-sticky-class={inner ? "header-sticky-black" : "header-sticky"}>
  <div class="home-nav-layout">
    <a class="renoir-brand" href={path("home", locale)} aria-label={`${c.site.name} — ${c.nav.home}`}>
      <BrandMark class="renoir-brand-mark" /><span class="renoir-wordmark">{c.site.name}</span>
    </a>
    <div class="home-nav-shell si-header-main2">
    <div class="home-nav-links si-header-menu si-header-dropdown dropdown-white-bg">
      <nav aria-label={locale === "id" ? "Navigasi utama" : "Main navigation"}><NavMenu locale={locale} /></nav>
    </div>
    <div class="home-nav-actions">
      <LangSwitch locale={locale} alternates={alternates} class="home-nav-lang" />
      <button class="si-header-search si-search-open-btn" type="button" aria-label={c.search.button} aria-controls="site-search" aria-expanded="false">
        <i class="fa-sharp fa-regular fa-magnifying-glass" aria-hidden="true"></i>
      </button>
      <button class="si-offcanvas-open-btn home-menu-button" type="button" aria-label={c.nav.openMenu} aria-controls="offcanvas" aria-expanded="false">
        <span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
      <a class="si-btn-one home-nav-cta" href={path("contact", locale)}><span class="btn-text"><span>{c.nav.cta}</span></span><span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right" aria-hidden="true"></i></span></a>
    </div>
  </div>
  </div>
</header>
