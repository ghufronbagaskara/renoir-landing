---
import Img from "~/components/ui/Img.astro";
import { imageUrl } from "~/lib/images";

interface Props {
  title: string;
  parent?: { label: string; href: string };
}
const { title, parent } = Astro.props;
const bg = await imageUrl("breadcumb/bg.jpg");
---
<section class="si-breadcumb-area" style={`background: url(${bg});`}>
  <div class="container container-1617">
    <div class="row">
      <div class="col-lg-12">
        <div class="si-breadcumb-box">
          <div class="si-breadcumb-text">
            <h1>{title}</h1>
            <nav aria-label="Breadcrumb">
              <span>
                <a href="/">Home</a>
                {parent && (<><i class="fa-sharp fa-regular fa-angles-right" aria-hidden="true"></i> <a href={parent.href}>{parent.label}</a> </>)}
                <strong aria-current="page"><i class="fa-sharp fa-regular fa-angles-right" aria-hidden="true"></i> {title}</strong>
              </span>
            </nav>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="si-breadcumb-shape">
    <Img src="breadcumb/shape.png" alt="" />
  </div>
</section>
