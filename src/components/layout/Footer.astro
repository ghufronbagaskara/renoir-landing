---
// Footer = closing call to action on every page + links + contact.
import { footerLinks } from "~/data/nav";
import BrandMark from "~/components/ui/BrandMark.astro";
import { site } from "~/data/site";
import { path, t, type Locale } from "~/i18n";

interface Props {
  locale: Locale;
  home?: boolean;
}
const { locale, home = false } = Astro.props;
const c = t(locale);
const links = footerLinks(locale);
---
<footer class="si-footer-area si-background">
  <BrandMark class="footer-watermark" variant="white" />
  <div class="container container-1588">
    <div class="row">
      <div class="col-lg-7">
        <div class="si-footer-text">
          <h2 class="h1">{c.footer.headline} <span>{c.footer.headlineEm}</span></h2>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="si-footer-p">
          <p>{c.footer.body}</p>
        </div>
      </div>
    </div>
    <div class="row border-line">
      <div class="col-lg-5 p-0">
        <div class="si-footer-logo">
          <a class="renoir-brand" href={path("home", locale)}><BrandMark class="renoir-brand-mark" variant="white" /><span class="renoir-wordmark">{c.site.name}</span></a>
          <p>{c.footer.tagline}</p>
        </div>
      </div>
      <div class="col-lg-2">
        <nav class="si-footer-list footer-left" aria-label={c.footer.studio}>
          <h2>{c.footer.studio}</h2>
          <ul>
            {links.studio.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      </div>
      <div class="col-lg-3">
        <nav class="si-footer-list footer-right" aria-label={c.footer.more}>
          <h2>{c.footer.more}</h2>
          <ul>
            {links.more.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      </div>
      <div class="col-lg-2">
        <div class:list={["si-footer-list footer-list", { "footer-list2": home }]}>
          <h2>{c.footer.contact}</h2>
          <ul>
            <li class="footer-color"><a href={path("contact", locale)}>{c.nav.cta}</a></li>
            <li><a href={path("contact", locale)}>{c.footer.location}</a></li>
            {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
          </ul>
        </div>
      </div>
    </div>
  </div>
  <div class="si-copyright-area p-0">
    <div class="container container-1588">
      <div class="row align-items-center copyright-line">
        <div class="col-lg-6 p-0">
          <div class="si-copyright-title">
            <p>© {new Date().getFullYear()} <a href={path("home", locale)}>{site.legal.entity ?? c.site.name}</a>. {c.footer.rights}{site.legal.nib && <> {c.footer.nib} {site.legal.nib}.</>}</p>
            {site.legal.address && <p>{site.legal.address}</p>}
          </div>
        </div>
        <div class="col-lg-6 p-0">
          <nav class="footer-legal" aria-label={c.footer.legal}>
            {links.legal.map((l) => <a href={l.href}>{l.label}</a>)}
            <button type="button" data-consent-open>{c.footer.cookieSettings}</button>
          </nav>
        </div>
      </div>
    </div>
  </div>
</footer>
