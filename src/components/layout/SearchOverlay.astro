---
import { child, t, type Locale } from "~/i18n";
import { getNotes, getServices, noteSlug, serviceCopy } from "~/lib/content";

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale).search;
const notes = (await getNotes(locale)).slice(0, 3);
const services = await getServices();
---
<dialog
  class="si-search-area"
  id="site-search"
  aria-labelledby="site-search-title"
  data-no-results={s.noResults}
  data-unavailable={s.unavailable}
  data-loading={s.loading}
  data-locale={locale}
  data-groups={JSON.stringify(s.groups)}
>
  <div class="search-command-shell">
    <header class="search-command-head">
      <div><span class="search-command-kicker">Renoir</span><h2 id="site-search-title">{s.label}</h2></div>
      <button class="si-search-close-btn" type="button" aria-label={s.close}>
        <svg width="14" height="14" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M11 1L1 11M1 1L11 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
      </button>
    </header>
    <form class="search-command-form" role="search" data-search-form>
      <label for="site-search-input" class="visually-hidden">{s.label}</label>
      <i class="fa-sharp fa-regular fa-magnifying-glass" aria-hidden="true"></i>
      <input id="site-search-input" type="search" name="q" placeholder={s.placeholder} autocomplete="off" aria-describedby="site-search-hint" />
      <kbd>Esc</kbd>
    </form>
    <p id="site-search-hint" class="search-command-hint">{s.hint}</p>

    <div class="search-command-default" data-search-default>
      <section aria-labelledby="search-paths-title">
        <h3 id="search-paths-title">{s.explore}</h3>
        <div class="search-command-paths">
          {services.map((service, index) => {
            const copy = serviceCopy(service, locale);
            return <a href={child("services", locale, copy.slug)}><span>{String(index + 1).padStart(2, "0")}</span>{copy.title}<i class="fa-sharp fa-regular fa-arrow-up-right" aria-hidden="true"></i></a>;
          })}
        </div>
      </section>
      <section aria-labelledby="search-recent-title">
        <h3 id="search-recent-title">{s.recent}</h3>
        <div class="search-command-recent">
          {notes.map((note) => <a href={child("notes", locale, noteSlug(note))}><span>{note.data.category}</span>{note.data.title}</a>)}
        </div>
      </section>
    </div>
    <ul class="si-search-results" data-search-results aria-live="polite" aria-label={s.label} hidden></ul>
  </div>
</dialog>
<script>
  import "~/scripts/search";
</script>
