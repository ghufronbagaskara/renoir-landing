---
import Img from "~/components/ui/Img.astro";
import NavMenu from "./NavMenu.astro";
---
<header id="header-sticky-black" class="si-header-area header-transparent si-header-3-area" data-sticky-class="header-sticky-black">
  <div class="container container-1619">
    <div class="row align-items-center">
      <div class="col-lg-12">
        <div class="si-header-3-main">
          <div class="si-header-logo">
            <a href="/" aria-label="Averix home">
              <Img class="logo-black" style="width:167px" src="logo/logo-white.png" alt="Averix" loading="eager" />
            </a>
          </div>
          <div class="si-header-main si-header-2-main si-header-3-left">
            <div class="si-header-right">
              <div class="si-header-box d-none d-xl-block">
                <div class="si-header-menu si-header-3-menu si-header-dropdown dropdown-white-bg">
                  <nav class="si-mobile-menu-active" aria-label="Main">
                    <NavMenu />
                  </nav>
                </div>
              </div>
            </div>
          </div>
          <div class="si-header-2-btn-main">
            <div class="si-header-search-box d-none d-md-block">
              <button class="si-header-search si-search-open-btn" type="button" aria-controls="site-search" aria-expanded="false">
                <span>
                  <Img src="header/search.svg" alt="" />
                </span>
                <span class="si-header-search-title header-3-title">Search</span>
              </button>
            </div>
            <div class="si-header-2-bar si-header-3-bar">
              <button class="si-header-2-bar-inner si-header-3-bar-inner si-offcanvas-open-btn" type="button" aria-label="Open menu" aria-controls="offcanvas" aria-expanded="false">
                <span class="line-one"></span>
                <span class="line-two"></span>
                <span class="line-three"></span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
