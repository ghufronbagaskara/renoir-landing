---
import NavMenu from "./NavMenu.astro";
import LangSwitch from "./LangSwitch.astro";
import BrandMark from "~/components/ui/BrandMark.astro";
import { path, t, type Alternates, type Locale } from "~/i18n";

interface Props {
  locale: Locale;
  alternates: Alternates;
  solid?: boolean;
}
const { locale, alternates, solid = false } = Astro.props;
const c = t(locale);
---
<header id="header-sticky-black" class:list={["si-header-area header-transparent si-header-3-area", { "renoir-solid-header": solid }]} data-sticky-class="header-sticky-black">
  <div class="container container-1619">
    <div class="row align-items-center">
      <div class="col-lg-12">
        <div class="si-header-3-main">
          <div class="si-header-logo">
            <a class="renoir-brand" href={path("home", locale)} aria-label={`${c.site.name} — ${c.nav.home}`}>
              <BrandMark class="renoir-brand-mark" />
              <span class="renoir-wordmark">{c.site.name}</span>
            </a>
          </div>
          <div class="si-header-main si-header-2-main si-header-3-left">
            <div class="si-header-right">
              <div class="si-header-box d-none d-xl-block">
                <div class="si-header-menu si-header-3-menu si-header-dropdown dropdown-white-bg">
                  <nav class="si-mobile-menu-active" aria-label="Main">
                    <NavMenu locale={locale} />
                  </nav>
                </div>
              </div>
            </div>
          </div>
          <div class="si-header-2-btn-main">
            <LangSwitch locale={locale} alternates={alternates} class="lang-switch-light d-none d-md-flex" />
            <div class="si-header-search-box">
              <button class="si-header-search si-search-open-btn" type="button" aria-label={c.search.button} aria-controls="site-search" aria-expanded="false">
                <span>
                  <i class="fa-sharp fa-regular fa-magnifying-glass" aria-hidden="true"></i>
                </span>
                <span class="si-header-search-title header-3-title">{c.search.button}</span>
              </button>
            </div>
            <div class="si-header-2-bar si-header-3-bar">
              <button class="si-header-2-bar-inner si-header-3-bar-inner si-offcanvas-open-btn" type="button" aria-label={c.nav.openMenu} aria-controls="offcanvas" aria-expanded="false">
                <span class="line-one"></span>
                <span class="line-two"></span>
                <span class="line-three"></span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
