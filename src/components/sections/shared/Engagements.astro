---
import { path, t, type Locale } from "~/i18n";
import Img from "~/components/ui/Img.astro";
import { getServices } from "~/lib/content";

interface Props { locale: Locale; variant?: "services" | "process" }
const { locale, variant } = Astro.props;
const e = t(locale).home.engagements;
const contact = path("contact", locale);
const services = variant ? await getServices() : [];
---
<section class:list={["engagement-rail pt-124 pb-130", { "engagement-rail--services": !!variant }]} aria-labelledby="engagement-title" data-hover-engagements={variant ? "" : undefined}>
  <div class="container container-1617">
    <div class="engagement-rail-head">
      <div class="si-section-title"><span>{e.label}</span><h2 id="engagement-title" class="si-text-revel-anim">{e.title}</h2></div>
      <p>{locale === "en" ? "Choose the kind of problem you need solved. The scope and fixed price come before the build." : "Pilih jenis masalah yang perlu diselesaikan. Scope dan harga tetap disepakati sebelum build dimulai."}</p>
      {variant && <div class="engagement-proof">{e.cards.map((card, index) => {
        const image = services.find((service) => service.data.build === card.build)!.data.images[0];
        return <figure hidden={index !== 0} data-engagement-proof={index}>
          <Img src={image.src} alt={image.alt[locale]} />
          <figcaption><span>{locale === "en" ? "From the founder’s portfolio" : "Dari portofolio pendiri"}</span>{image.caption[locale]}</figcaption>
        </figure>;
      })}</div>}
    </div>
    <div class="engagement-rail-list">
      {e.cards.map((card, index) => (
        <details class="engagement-item" name={variant ? undefined : "engagements"} open={index === 0} data-line-reveal>
          <summary>
            <span class="engagement-number">{String(index + 1).padStart(2, "0")}</span>
            <span class="engagement-name"><small>{card.badge}</small>{card.title}</span>
            <span class="engagement-audience">{card.audience}</span>
            <span class="engagement-toggle" aria-hidden="true"><i class="fa-sharp fa-regular fa-plus"></i></span>
          </summary>
          <div class="engagement-panel">
            <div class="engagement-price"><strong>{card.priceLine}</strong>{card.note && <span>{card.note}</span>}</div>
            <ul>{card.items.map((item) => <li><i class="fa-sharp fa-regular fa-check" aria-hidden="true"></i>{item}</li>)}</ul>
            <a href={`${contact}?build=${card.build}`}>{card.cta}<i class="fa-sharp fa-regular fa-arrow-up-right" aria-hidden="true"></i></a>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
<script>
  import "~/scripts/reveal-lines";
  import "~/scripts/engagement-hover";
</script>
