---
import Img from "~/components/ui/Img.astro";
---
<section class="si-testimonial-area pt-124">
    <div class="container container-1617">
        <div class="row">
            <div class="col-lg-4">
                <div class="si-testimonial-shape">
                    <Img class="rotate2" src="testimonial/shape-text.png" alt="" />
