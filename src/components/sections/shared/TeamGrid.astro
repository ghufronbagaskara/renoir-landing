---
import Img from "~/components/ui/Img.astro";
import { getTeam } from "~/lib/content";

interface Props {
  limit?: number;
  animate?: boolean;
}
const { limit, animate = false } = Astro.props;
const team = (await getTeam()).slice(0, limit);
const X_ICON = "M453.2 112L523.8 112L369.6 288.2L551 528L409 528L297.7 382.6L170.5 528L99.8 528L264.7 339.5L90.8 112L236.4 112L336.9 244.9L453.2 112zM428.4 485.8L467.5 485.8L215.1 152L173.1 152L428.4 485.8z";
---
<section class="si-team-area pt-124 pb-130">
  <div class="container container-1617">
    <div class="row">
      <div class="col-lg-12">
        <div class="si-section-title text-center pb-40">
          <span>Who We Are</span>
          <h2 class:list={{ "si-text-revel-anim": animate }}>Creative Team Members</h2>
        </div>
      </div>
      {
        team.map((m) => (
          <div class="col-lg-6 col-xl-3 col-xxl-3">
            <div class="si-team-box team-bottom">
              <div class="si-team-thumb">
                <a href={`/team/${m.id}/`} tabindex="-1" aria-hidden="true">
                  <Img src={m.data.image} alt="" />
                </a>
                <div class="si-team-text">
                  <div class="si-team-text-inner">
                    <h3><a class="text-reset" href={`/team/${m.id}/`}>{m.data.name}</a></h3>
                    <span>{m.data.role}</span>
                    <ul>
                      <li><a href={m.data.socials.x} aria-label={`${m.data.name} on X`} rel="noopener" target="_blank"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" aria-hidden="true"><path d={X_ICON} /></svg></a></li>
                      <li><a href={m.data.socials.instagram} aria-label={`${m.data.name} on Instagram`} rel="noopener" target="_blank"><i class="fa-brands fa-instagram"></i></a></li>
                      <li><a href={m.data.socials.linkedin} aria-label={`${m.data.name} on LinkedIn`} rel="noopener" target="_blank"><i class="fa-brands fa-linkedin-in"></i></a></li>
                      <li><a href={m.data.socials.behance} aria-label={`${m.data.name} on Behance`} rel="noopener" target="_blank"><i class="fa-brands fa-behance"></i></a></li>
                      <li><a href={m.data.socials.pinterest} aria-label={`${m.data.name} on Pinterest`} rel="noopener" target="_blank"><i class="fa-brands fa-pinterest-p"></i></a></li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
