---
// Template awards list, copy only: "Why work with us" (home) and "Who we're for" (about).
interface Props {
  title: string;
  rows: { title: string; tag: string }[];
}
const { title, rows } = Astro.props;
---
<section class="si-award-area pb-95">
  <div class="container container-1617">
    <div class="row">
      <div class="col-lg-12">
        <div class="si-award-text">
          <h2 class="h3">{title}</h2>
        </div>
        {
          rows.map((row, i) => (
            <div class="si-award-items">
              <p class="group">{row.title}</p>
              <p class="time">{String(i + 1).padStart(2, "0")}</p>
              <p class="award">{row.tag}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
