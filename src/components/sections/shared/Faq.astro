---
import Accordion from "~/components/ui/Accordion.astro";
import { faq } from "~/data/faq";
---
<section class="si-faq-area pt-124">
  <div class="container container-1617">
    <div class="row">
      <div class="col-lg-5">
        <div class="si-section-title pb-78">
          <span>question</span>
          <h2 class="si-text-revel-anim">Questions and <br class="d-none d-xxl-block" /> answers</h2>
        </div>
      </div>
      <div class="col-lg-7">
        <div class="si-faq-box">
          <div class="si-faq-accordion-wrap">
            <Accordion id="faq" items={faq} />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
