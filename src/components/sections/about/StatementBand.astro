---
import CircleText from "~/components/ui/CircleText.astro";
import { imageUrl } from "~/lib/images";

interface Props {
  circle: string;
  label: string;
  href: string;
}
const { circle, label, href } = Astro.props;
const bg = imageUrl("editorial/about-cta.webp");
---
<div class="si-video-area" style={`background-image:url(${bg})`}>
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <div class="si-video-icon">
          <div class="si-video-icon-inner">
            <a href={href} aria-label={label}><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
            <div class="si-video-shape">
              <CircleText class="rotate2 video-circle" text={circle} size={145} variant="ring" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
