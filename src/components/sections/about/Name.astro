---
import Img from "~/components/ui/Img.astro";
import BrandMark from "~/components/ui/BrandMark.astro";
import { path, t, type Locale } from "~/i18n";
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale);
const n = c.about.name;
---
<section class="si-about-area studio-work pt-124 pb-130">
  <div class="container container-1617">
    <div class="studio-work-heading">
      <div class="si-section-title"><span>{n.label}</span><h2>{n.title}</h2></div>
      <div class="studio-signature"><BrandMark /><strong>{c.site.name}</strong></div>
    </div>
    <div class="studio-work-grid">
      <figure class="studio-work-screen">
        <Img src="work/order-sales/pair.webp" alt={locale === "en" ? "Order management on desktop and the Sales Dashboard on mobile" : "Pengelolaan pesanan di desktop dan Beranda Sales di ponsel"} />
        <figcaption><span>{locale === "en" ? "From the founder’s portfolio · isolated demo" : "Dari portofolio pendiri · demo terpisah"}</span><a href={path("work", locale)}>{locale === "en" ? "Explore the work" : "Lihat karya"} ↗</a></figcaption>
      </figure>
      <div class="studio-work-story"><span class="studio-work-kicker">DESIGN / BUILD / RUN</span><h3>{n.cardTitle}</h3><p>{n.cardBody}</p><div class="studio-work-stages"><span>01 / Design</span><span>02 / Build</span><span>03 / Run</span></div></div>
    </div>
  </div>
</section>
