---
import Img from "~/components/ui/Img.astro";
import { formatDate, getPosts } from "~/lib/content";

const posts = await getPosts();
const categories = Object.entries(
  posts.reduce<Record<string, number>>((acc, p) => ((acc[p.data.category] = (acc[p.data.category] ?? 0) + 1), acc), {}),
);
const tags = [...new Set(["Agency", "Awards", "Marketing", "Brand", "Contemporary", "Education", "Business", "Modern", "Ideas", ...posts.flatMap((p) => p.data.tags)])];
---
<aside class="si-blolg-standard-main" aria-label="Blog sidebar">
  <div class="si-blog-sidebar-search">
    <form class="si-blog-sidebar-searchtwo" role="search" action="/blog/" data-sidebar-search>
      <label class="visually-hidden" for="blog-search">Search articles</label>
      <input id="blog-search" type="search" name="q" placeholder="Search here" />
      <div class="si-blog-sidebar-icontwo">
        <a class="no-href" role="button" tabindex="0" aria-label="Search" data-submit>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M11 19C15.4183 19 19 15.4183 19 11C19 6.58172 15.4183 3 11 3C6.58172 3 3 6.58172 3 11C3 15.4183 6.58172 19 11 19Z" stroke="white" stroke-width="2" stroke-linecap="square" />
            <path d="M20.9984 20.9984L16.6484 16.6484" stroke="white" stroke-width="2" stroke-linecap="square" />
          </svg>
        </a>
      </div>
    </form>
  </div>
  <div class="si-blog-sidebar-text">
    <h2 class="sidebar-heading"><a class="no-href">Categories</a></h2>
    {
      categories.map(([name, count]) => (
        <div class="si-blog-sidebar-main">
          <div class="si-blog-sidebar-text2">
            <span>{name}</span>
          </div>
          <div class="si-blog-sidebar-number">
            <ul>
              <li>({count})</li>
            </ul>
          </div>
        </div>
      ))
    }
  </div>
  <div class="si-blog-sidebar-post">
    <h2><a class="no-href">Recent Posts</a></h2>
    {
      posts.slice(0, 4).map((post) => (
        <div class="si-blog-sidebar-right">
          <div class="si-blog-sidebar-imgtwo">
            <Img src={post.data.thumb} alt="" />
          </div>
          <div class="si-blog-sidebar-texttwo">
            <h3>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h3>
            <span>{formatDate(post.data.date, "short")}</span>
          </div>
        </div>
      ))
    }
  </div>
  <div class="si-blog-sidebar-tags">
    <h2 class="sidebar-heading"><a class="no-href">Tags</a></h2>
    {tags.map((t) => <span><a class="no-href">{t}</a></span>)}
  </div>
</aside>
<script>
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-sidebar-search]")) {
    form.querySelector("[data-submit]")?.addEventListener("click", () => form.requestSubmit());
  }
</script>
