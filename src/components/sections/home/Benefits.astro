---
import BrandMark from "~/components/ui/BrandMark.astro";
import { t, type Locale } from "~/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const why = t(locale).home.why;
const icons = [
  "m8 7-5 5 5 5m8-10 5 5-5 5m-3-14-2 18",
  "M4.5 18a9 9 0 1 1 15 0M12 3v2M5.6 5.6 7 7m11.4-1.4L17 7m-5 5 4-4m-5 4a1 1 0 1 0 2 0 1 1 0 0 0-2 0",
  "M9 4a3 3 0 1 0 0 6 3 3 0 0 0 0-6m8 1a2.5 2.5 0 0 1 0 5M3 20v-2a6 6 0 0 1 12 0v2m3-7a5 5 0 0 1 3 4.6V20",
  "M3 7h6l2 2h10v11H3V7Zm0 0V4h7l2 3h7v2m-10 5 2 2 4-4",
  "M4 4h16v12H9l-5 4V4Zm4 4h8m-8 4h5",
];
---
<section class="si-award-area home-benefits" id="benefits" aria-labelledby="benefits-title">
  <div class="container container-1617">
    <div class="home-benefits-layout">
      <div class="home-benefits-intro">
        <header>
          <p class="home-benefits-label">{why.label}</p>
          <h2 id="benefits-title">{why.title}</h2>
        </header>

        <figure class="home-benefits-package">
          <svg class="home-benefits-art" viewBox="0 0 460 270" width="460" height="270" aria-hidden="true" focusable="false">
            <path d="M30 246h394" fill="none" stroke="#596273" stroke-width="1" />
            <g transform="rotate(-9 144 142)">
              <path d="M58 59h140l31 31v145H58Z" fill="#242A32" stroke="#7C899C" stroke-width="1.5" />
              <path d="M198 59v31h31" fill="none" stroke="#7C899C" stroke-width="1.5" />
              <rect x="79" y="91" width="93" height="58" rx="3" fill="none" stroke="#DBEAFE" stroke-width="1.5" />
              <path d="m79 137 30-25 23 18 21-11 19 18M80 172h89m-89 13h112m-112 13h66" fill="none" stroke="#DBEAFE" stroke-width="1.5" stroke-linecap="round" />
              <circle cx="151" cy="106" r="5" fill="#DBEAFE" />
            </g>
            <g transform="rotate(6 268 130)">
              <path d="M176 25h143l33 33v174H176Z" fill="#FFFFFF" />
              <path d="M319 25v33h33" fill="#DBEAFE" />
              <path d="m224 76-15 15 15 15m71-30 15 15-15 15m-31-39-11 48" fill="none" stroke="#1D4ED8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M199 140h93m-93 14h119m-119 14h80m-80 31h39" fill="none" stroke="#AAB7CB" stroke-width="2" stroke-linecap="round" />
            </g>
            <rect x="300" y="169" width="101" height="72" rx="9" fill="#1D4ED8" />
            <path d="M318 190h22m-22 10h15m3 15 10 10 21-25m16-10v35" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <figcaption>
            <span>{why.handover.label}</span>
            <ul role="list">
              {why.handover.items.map((item) => <li>{item}</li>)}
            </ul>
          </figcaption>
        </figure>

        <div class="home-benefits-brand">
          <BrandMark variant="white" />
          <span>Katalhys</span>
        </div>
      </div>

      <ul class="home-benefits-sheet" role="list">
        {why.rows.map((row, i) => (
          <li class="home-benefits-item">
            <span class="home-benefits-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <path d={icons[i]} />
              </svg>
            </span>
            <div>
              <span class="home-benefits-tag">{row.tag}</span>
              <h3>{row.title}</h3>
              <p>{row.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .home-benefits.si-award-area {
    padding: clamp(48px, 4vw, 72px) 0;
    scroll-margin-top: 110px;
    background: var(--renoir-ink);
    color: #fff;
  }
  .home-benefits-layout {
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
    align-items: stretch;
    gap: clamp(40px, 5vw, 88px);
    padding: 0 clamp(8px, 1.8vw, 32px);
  }
  .home-benefits-intro { min-width: 0; display: flex; flex-direction: column; }
  .home-benefits-label {
    margin: 0 0 24px; color: #b8c5d8; font-size: 12px; line-height: 1.5;
    font-weight: 500; letter-spacing: .08em; text-transform: uppercase;
  }
  .home-benefits h2 {
    max-width: 12ch; margin: 0; color: #fff; font-size: clamp(40px, 4.5vw, 66px);
    font-weight: 600; letter-spacing: -.045em; line-height: 1.05; text-wrap: balance;
  }
  .home-benefits-package { width: 100%; max-width: 460px; margin: auto 0; padding: 24px 0; }
  .home-benefits-art { display: block; width: 100%; height: auto; }
  .home-benefits-package figcaption { margin-top: 20px; }
  .home-benefits-package figcaption > span {
    display: block; color: #b8c5d8; font-size: 12px; line-height: 1.5; margin-bottom: 10px;
  }
  .home-benefits-package ul { display: flex; flex-wrap: wrap; gap: 8px 18px; list-style: none; margin: 0; padding: 0; }
  .home-benefits-package li { font-size: 13px; line-height: 1.6; color: #fff; }
  .home-benefits-brand {
    display: flex; align-items: center; gap: 10px; margin-top: auto; padding-top: 24px;
    font-family: var(--si-ff-heading); font-size: 28px; font-weight: 600; letter-spacing: -.035em;
  }
  .home-benefits-brand :global(svg) { display: block; width: 34px; height: 34px; }
  .home-benefits-sheet {
    min-width: 0; list-style: none; padding: 6px 32px; margin: 0 10px 12px 0;
    background: #fff; color: var(--renoir-ink); box-shadow: 10px 12px 0 #ffffff12;
  }
  .home-benefits-item {
    display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 20px;
    padding: 18px 0; border-top: 1px solid var(--renoir-line);
  }
  .home-benefits-item:first-child { border-top: 0; }
  .home-benefits-icon {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 8px;
    background: #eef2f8; color: var(--renoir-accent); transition: background-color 180ms ease;
  }
  .home-benefits-item:hover .home-benefits-icon { background: #dbeafe; }
  .home-benefits-tag {
    display: block; margin-bottom: 8px; color: var(--renoir-accent);
    font-size: 10px; font-weight: 600; line-height: 1.5; letter-spacing: .1em; text-transform: uppercase;
  }
  .home-benefits h3 {
    color: var(--renoir-ink); margin: 0 0 9px; font-size: clamp(21px, 1.7vw, 26px);
    font-weight: 600; line-height: 1.2; letter-spacing: -.03em;
  }
  .home-benefits-item p { color: var(--renoir-muted); margin: 0; max-width: 52ch; font-size: 15px; line-height: 1.65; }
  @media (max-width: 991px) {
    .home-benefits-layout { grid-template-columns: 1fr; gap: 32px; padding: 0 12px; }
    .home-benefits-intro { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 20px; }
    .home-benefits h2 { font-size: clamp(36px, 5vw, 52px); max-width: 16ch; }
    .home-benefits-package { margin: 0; padding: 0; }
    .home-benefits-package figcaption { margin-top: 8px; }
    .home-benefits-brand { display: none; }
    .home-benefits-sheet { padding: 6px 28px; }
    .home-benefits-item { padding: 22px 0; }
  }
  @media (max-width: 600px) {
    .home-benefits-layout { padding: 0 8px; }
    .home-benefits-intro { display: block; }
    .home-benefits-label { margin-bottom: 16px; }
    .home-benefits h2 { font-size: clamp(34px, 8.5vw, 42px); }
    .home-benefits-package { max-width: 330px; margin: 24px auto 0; }
    .home-benefits-package figcaption { margin-top: 12px; }
    .home-benefits-package ul { gap: 5px 14px; }
    .home-benefits-sheet { padding: 4px 18px; margin-right: 6px; box-shadow: 6px 8px 0 #ffffff12; }
    .home-benefits-item { grid-template-columns: 34px minmax(0, 1fr); gap: 12px; padding: 22px 0; }
    .home-benefits-icon { width: 34px; height: 34px; border-radius: 6px; }
    .home-benefits-icon svg { width: 23px; height: 23px; }
    .home-benefits-tag { margin-bottom: 7px; }
    .home-benefits h3 { font-size: 21px; }
    .home-benefits-item p { font-size: 14px; line-height: 1.7; }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-benefits-icon { transition: none; }
  }
</style>
