---
import Img from "~/components/ui/Img.astro";
import heroVideo from "~/assets/video/katalhys-hero.mp4?url";
import heroVideoMobile from "~/assets/video/katalhys-hero-mobile.mp4?url";
import { imageUrl } from "~/lib/images";
import { t, path, type Locale } from "~/i18n";
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale);
const h = c.home.hero;
---
<section class="si-hero-area home-cinema" aria-labelledby="home-title">
  <div class="home-cinema-media" aria-hidden="true">
    <picture>
      <source media="(max-width: 767px)" srcset={imageUrl("home-refresh/hero-poster-mobile.webp")} />
      <Img src="home-refresh/hero-poster.webp" alt="" loading="eager" fetchpriority="high" />
    </picture>
    <video data-hero-video data-src={heroVideo} data-mobile-src={heroVideoMobile} muted loop playsinline preload="none" tabindex="-1" hidden></video>
  </div>
  <div class="home-cinema-copy">
    <p class="home-cinema-label">{h.label}</p>
    <h1 id="home-title">{h.title.map((line, i) => <span class:list={{ "home-cinema-emphasis": i === 1 }}>{line}{" "}</span>)}</h1>
    <p class="home-cinema-lede">{h.body}</p>
    <div class="home-cinema-actions">
      <a class="home-action home-action-primary" href={path("contact", locale)}>{c.nav.cta}<span aria-hidden="true">↗</span></a>
      <a class="home-action home-action-glass" href="#selected-work">{h.work}<span aria-hidden="true">↓</span></a>
    </div>
  </div>
  <button class="home-video-toggle" data-video-toggle type="button" data-pause={h.pause} data-play={h.play} aria-label={h.play} hidden><span aria-hidden="true">▶</span></button>
</section>
<script>import "~/scripts/hero-video";</script>
