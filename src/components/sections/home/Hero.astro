---
import Img from "~/components/ui/Img.astro";
---
<section class="si-hero-area">
    <div class="container container-1617">
        <div class="row">
            <div class="col-lg-12">
                <div class="si-hero-text">
                    <h1 class="si-text-revel-anim">Bold Brands <br class="d-none d-xxl-block"> Creative Design <br class="d-none d-xxl-block"> Studio.</h1>
                </div>
                <div class="si-hero-text2">
                    <p>Identify the key barriers that prevent your business from <br> reaching its full potential. Addressing these issues can <br> transform your path to success.</p>
                </div>
            </div>
        </div>
    </div>
    <div class="si-hero-thumb fix z-index-1">
        <Img class="w-100" data-speed=".4" src="banner/banner-1.jpg" alt="Creative team collaborating in the studio" loading="eager" fetchpriority="low" />
    </div>
    <div class="si-hero-shape">
        <Img src="hero/shape.png" alt="" loading="eager" />
    </div>
    <div class="si-hero-shape2">
        <Img src="hero/shape2.png" alt="" loading="eager" fetchpriority="high" />
    </div>                        
</section>
