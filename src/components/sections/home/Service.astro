---
import Img from "~/components/ui/Img.astro";
import { getServices, serviceCopy } from "~/lib/content";
import { child, path, t, type Locale } from "~/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale).home.services;
const services = await getServices();
---
<section class="si-service-area pt-124 pb-130 position-relative z-1">
  <div class="container container-1617">
    <div class="row justify-content-between align-items-center">
      <div class="col-lg-12">
        <div class="si-service-right">
          <div class="si-section-title pb-60 si-white">
            <span>{s.label}</span>
            <h2 class="si-text-revel-anim">{s.title}</h2>
            <p>{s.body}</p>
          </div>
          <div class="si-service-btn">
            <a class="si-btn-one black-bg-btn" href={path("services", locale)}> <span class="btn-text"> <span>{s.button}</span> </span> <span class="btn-icon btn-icon2"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></a>
          </div>
        </div>
      </div>
    </div>
    <div class="row align-items-center">
      <div class="col-xl-5 col-lg-5">
        <div class="si-service-list-thumb-wrap position-relative">
          <div id="si-service-thumb" class="si-service-list-thumb-1">
            {services.map((entry, i) => <Img class={`si-service-list-thumb-${i + 1}`} src={entry.data.thumb} alt="" />)}
          </div>
        </div>
      </div>
      <div class="col-xl-7 col-lg-7">
        <div class="si-service-list-wrap">
          {
            services.map((entry, i) => {
              const copy = serviceCopy(entry, locale);
              return (
                <a
                  class:list={["si-service-list-item d-flex align-items-center justify-content-between cursor-pointer position-relative", { active: i === 0 }]}
                  data-thumb={`si-service-list-thumb-${i + 1}`}
                  href={child("services", locale, copy.slug)}
                >
                  <div class="si-service-list-left">
                    <h3 class="si-service-list-title fw-semibold">
                      <span class="text--white">{copy.title}</span>
                    </h3>
                  </div>
                  <i class="fa-sharp fa-regular fa-arrow-up-right" aria-hidden="true"></i>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  // Template main.js #23: swap the thumbnail on hover/focus.
  const thumb = document.getElementById("si-service-thumb");
  for (const item of document.querySelectorAll<HTMLElement>(".si-service-list-item")) {
    const activate = () => {
      if (thumb) thumb.className = item.dataset.thumb!;
      item.parentElement?.querySelectorAll(".active").forEach((el) => el.classList.remove("active"));
      item.classList.add("active");
    };
    item.addEventListener("mouseenter", activate);
    item.addEventListener("focusin", activate);
  }
</script>
