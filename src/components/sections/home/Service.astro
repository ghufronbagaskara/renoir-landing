---
import WorksWheel from "~/components/ui/WorksWheel.astro";
import { getServices, serviceCopy } from "~/lib/content";
import { child, path, t, type Locale } from "~/i18n";
interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale).home.services;
const entries = await getServices();
const art = ["marketing", "internal", "design", "care"];
const services = entries.map((entry, i) => ({
  ...s.items[i],
  href: child("services", locale, serviceCopy(entry, locale).slug),
  image: `home-refresh/service-${art[i]}.webp`,
}));
const projects = ["order-sales", "field-projects", "maxy-ai", "industrial-coatings", "expert-profile"].map((id) => `home-refresh/project-${id}.webp`);
---
<section class="si-service-area home-services" aria-labelledby="home-services-title">
  <div class="container container-1617">
    <div class="home-section-head">
      <div><p class="home-section-label">{s.label}</p><h2 id="home-services-title">{s.title}</h2></div>
      <div class="home-section-intro"><p>{s.body}</p><a class="home-text-link" href={path("services", locale)}>{s.button}<span aria-hidden="true">↗</span></a></div>
    </div>
    <WorksWheel services={services} projects={projects} label={s.wheelLabel} detail={s.detail} hint={s.hint} previous={s.previous} next={s.next} overview={s.overview} />
  </div>
</section>
