---
import Img from "~/components/ui/Img.astro";
import { imageUrl } from "~/lib/images";
import { child, path, t, type Locale } from "~/i18n";
import { getPortfolio, portfolioCopy } from "~/lib/content";
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale);
const w = c.home.work;
const projects = (await getPortfolio()).filter((project) => project.data.homeRank).sort((a, b) => a.data.homeRank! - b.data.homeRank!);
---
<section id="selected-work" class="home-featured-work" aria-labelledby="home-work-title" data-home-tabs>
  <div class="container container-1617">
    <div class="home-section-head">
      <div><p class="home-section-label">{w.label}</p><h2 id="home-work-title">{w.title}</h2></div>
      <div class="home-section-intro"><p>{w.body}</p><span class="home-project-count">{w.count} / <strong>{String(projects.length).padStart(2, "0")}</strong></span></div>
    </div>
    <div class="home-project-controls">
    <div class="home-project-tabs" data-tab-controls aria-label={w.count} hidden>
      {projects.map((project, i) => <button type="button" id={`work-tab-${i}`} data-tab><span aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>{portfolioCopy(project, locale).title}</button>)}
    </div>
    <button class="home-work-rotation" data-project-rotation data-pause={w.pause} data-resume={w.resume} aria-label={w.pause} type="button" hidden><span aria-hidden="true">Ⅱ</span></button>
    </div>
    <div class="home-project-stage">
    {projects.map((project, i) => {
      const copy = portfolioCopy(project, locale);
      return <div id={`work-panel-${i}`} class="home-project-panel" data-tab-panel>
        <figure class="home-project-visual">
          <Img src={project.data.pairImage} srcset={`${imageUrl(project.data.pairImage.replace("pair.webp", "pair-mobile.webp"))} 720w, ${imageUrl(project.data.pairImage)} 1800w`} sizes="(max-width: 767px) calc(100vw - 58px), (min-width: 1700px) 800px, 48vw" alt={`${copy.title} — ${w.screens}`} />
          <figcaption>{project.data.imageNote ? (locale === "en" ? project.data.imageNote.en : project.data.imageNote.id_) : w.screens}</figcaption>
        </figure>
        <div class="home-project-info">
          <p class="home-project-meta">{c.work.services[project.data.primaryService]}{project.data.year && ` / ${project.data.year}`}</p>
          <h3>{copy.title}</h3>
          <p class="home-project-summary">{copy.overview}</p>
          <details class="home-project-extra" open>
            <summary>{w.approach}<span aria-hidden="true">+</span></summary>
            <ul class="home-project-services" aria-label={c.work.details.services}>{project.data.serviceIds.map((id) => <li>{c.work.services[id]}</li>)}</ul>
            <div class="home-project-approach"><span>{w.approach}</span><p>{copy.approach}</p></div>
          </details>
          <a class="home-action home-action-primary" href={child("work", locale, project.id)}>{w.caseStudy}<span aria-hidden="true">↗</span></a>
        </div>
      </div>;
    })}
    </div>
    <div class="home-work-all"><a class="home-text-link" href={path("work", locale)}>{c.work.allTitle}<span aria-hidden="true">→</span></a></div>
  </div>
</section>
<script>
  import "~/scripts/project-showcase";
</script>
