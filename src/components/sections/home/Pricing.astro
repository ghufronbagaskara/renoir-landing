---
import Img from "~/components/ui/Img.astro";
import { imageUrls } from "~/lib/images";
const img = await imageUrls(["pricing/bg.png"]);
---
<section class="si-pricing-area pt-124 pb-130">
    <div class="container container-1617">
        <div class="row">
            <div class="col-lg-12">
                <div class="si-section-title text-center pb-60">
                    <span>Our pricing</span>
                    <h2 class="si-text-revel-anim">Discover Your Ideal Plan</h2>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="si-pricing-box si-background" style={`background-image:url(${img["pricing/bg.png"]})`}>
                    <div class="si-pricing-icon">
                        <a class="no-href"><Img src="pricing/fire.svg" alt="" /> 20% Off</a>
                    </div>
                    <div class="si-pricing-text">
                        <h2>Basic plan</h2>
                        <span>Ideal for scalable businesses or startups.</span>
                        <h3>$99.00 <span>/Monthly</span></h3>
                        <ul>
                            <li><Img src="pricing/pricing-icon.svg" alt="" />Access basic features</li>
                            <li><Img src="pricing/pricing-icon.svg" alt="" />Work customization</li>
                            <li><Img src="pricing/pricing-icon.svg" alt="" />Mobile and desktop</li>
                            <li><Img src="pricing/pricing-icon.svg" alt="" />Access design basic</li>
                            <li><Img src="pricing/pricing-icon.svg" alt="" />Priority customer</li>
                        </ul>
                        <a href="/contact/">Go with this plan <i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="si-pricing-box pricing-box si-background" style={`background-image:url(${img["pricing/bg.png"]})`}>
                    <div class="si-pricing-icon">
                        <a class="no-href"><Img src="pricing/fire.svg" alt="" /> 20% Off</a>
                    </div>
                    <div class="si-pricing-text">
                        <h2>Standard Plan</h2>
                        <span>Ideal for scalable businesses or startups.</span>
                        <h3>$119.00 <span>/Monthly</span></h3>
                        <ul>
                            <li><Img src="pricing/pricing-icon.svg" alt="" />Access basic features</li>
                            <li><Img src="pricing/pricing-icon.svg" alt="" />Work customization</li>
                            <li><Img src="pricing/pricing-icon.svg" alt="" />Mobile and desktop</li>
                            <li><Img src="pricing/pricing-icon.svg" alt="" />Access design basic</li>
                            <li><Img src="pricing/pricing-icon.svg" alt="" />Priority customer</li>
                        </ul>
                        <a href="/contact/">Go with this plan <i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="si-pricing-box pricing-box si-background" style={`background-image:url(${img["pricing/bg.png"]})`}>
                    <div class="si-pricing-icon">
                        <a class="no-href"><Img src="pricing/fire.svg" alt="" /> 20% Off</a>
                    </div>
                    <div class="si-pricing-text">
                        <h2>Premium plan</h2>
                        <span>Ideal for scalable businesses or startups.</span>
                        <h3>$139.00 <span>/Monthly</span></h3>
                        <ul>
                            <li><Img src="pricing/pricing-icon.svg" alt="" />Access basic features</li>
                            <li><Img src="pricing/pricing-icon.svg" alt="" />Work customization</li>
                            <li><Img src="pricing/pricing-icon.svg" alt="" />Mobile and desktop</li>
                            <li><Img src="pricing/pricing-icon.svg" alt="" />Access design basic</li>
                            <li><Img src="pricing/pricing-icon.svg" alt="" />Priority customer</li>
                        </ul>
                        <a href="/contact/">Go with this plan <i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
