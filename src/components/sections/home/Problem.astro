---
import Img from "~/components/ui/Img.astro";
import { child, t, type Locale } from "~/i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const p = t(locale).home.problem;
const service = child("services", locale, locale === "en" ? "internal-systems" : "sistem-internal");
---
<section id="the-problem" class="si-about-area home-problem" aria-labelledby="problem-title">
  <div class="container container-1617">
    <div class="problem-heading">
      <div><p class="home-section-label">{p.label}</p><h2 id="problem-title">{p.title}</h2></div>
      <p class="problem-intro">{p.intro}</p>
    </div>
    <figure class="problem-map" aria-describedby="problem-caption">
      <div class="problem-sources">
        <h3>{p.sourcesLabel}</h3>
        <ul>
          {p.sources.map((source, i) => <li>
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {i === 0 ? <><path d="M5 5h22v16H15l-8 6v-6H5Z" /><path d="M10 11h12M10 16h8" /></> : i === 1 ? <><path d="M6 4h20v24H6ZM6 11h20M6 19h20M14 11v17M21 11v17" /></> : <><path d="M9 4h10l6 6v18H9ZM19 4v7h6M13 17h8M13 22h8" /><path d="M5 9v18" /></>}
            </svg>
            <div><span>{source.name}</span><p>{source.detail}</p></div>
          </li>)}
        </ul>
      </div>
      <svg class="problem-connector" viewBox="0 0 84 284" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M0 42h10q22 0 22 22v56q0 22 22 22h28M0 142h82M0 242h10q22 0 22-22v-56q0-22 22-22" />
        <path d="m74 135 8 7-8 7" />
      </svg>
      <svg class="problem-connector-mobile" viewBox="0 0 32 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M16 3v40m-7-7 7 7 7-7" /></svg>
      <div class="problem-workspace">
        <p class="problem-workspace-label"><span aria-hidden="true"></span>{p.stat}</p>
        <h3>{p.cardTitle}</h3>
        <dl class="problem-fields">{p.fields.map(field => <div><dt>{field.label}</dt><dd>{field.value}</dd></div>)}</dl>
        <div class="problem-assistance">
          <p>{p.aiLabel}</p>
          <ul>{p.aiActions.map(action => <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m4 8 3 3 5-6" /></svg>{action}</li>)}</ul>
        </div>
        <p class="problem-decision">{p.decision}</p>
      </div>
      <figcaption id="problem-caption">{p.illustration}</figcaption>
    </figure>
    <div class="problem-bottom">
      <a class="problem-proof" href={child("work", locale, "order-sales")}>
        <Img src="work/order-sales/pair-thumb.webp" alt={p.proofAlt} />
        <span><small>{p.proofLabel}</small><strong>{p.proofTitle}<span aria-hidden="true"> ↗</span></strong></span>
      </a>
      <a class="home-text-link problem-service-link" href={service}>{p.button}<span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .home-problem { padding: clamp(64px, 7vw, 112px) 0; background: #fff; }
  .problem-heading { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(260px, .65fr); gap: 40px; align-items: end; margin-bottom: 36px; }
  .problem-heading .home-section-label { margin-bottom: 20px; }
  .problem-heading h2 { max-width: 20ch; margin: 0; font-size: clamp(32px, 3.5vw, 56px); line-height: 1.08; letter-spacing: -.045em; }
  .problem-intro { max-width: 43ch; margin: 0 0 3px; color: var(--renoir-muted); font-size: 16px; line-height: 1.65; }
  .problem-map { display: grid; grid-template-columns: minmax(210px, .8fr) 84px minmax(0, 1.2fr); align-items: center; margin: 0; padding: clamp(24px, 3vw, 44px); border: 1px solid var(--renoir-line); border-radius: 20px; background: var(--renoir-panel); }
  .problem-sources h3 { margin: 0 0 16px; font-size: 14px; font-weight: 500; line-height: 20px; color: var(--renoir-muted); }
  .problem-sources ul, .problem-assistance ul { list-style: none; padding: 0; margin: 0; }
  .problem-sources ul { display: grid; gap: 16px; }
  .problem-sources li { display: flex; align-items: center; gap: 16px; height: 84px; padding: 14px 18px; border: 1px solid #cbd3df; border-radius: 10px; background: #fff; }
  .problem-sources li > svg { flex: none; width: 32px; height: 32px; color: #62728d; }
  .problem-sources li span { display: block; margin-bottom: 4px; color: var(--renoir-muted); font-size: 12px; }
  .problem-sources li p { margin: 0; font-size: 15px; line-height: 1.35; color: var(--renoir-ink); }
  .problem-connector { display: block; width: 84px; height: 284px; margin-top: 36px; color: var(--renoir-accent); }
  .problem-connector-mobile { display: none; }
  .problem-workspace { padding: clamp(24px, 2.8vw, 40px); border-radius: 12px; background: var(--renoir-ink); color: #fff; }
  .problem-workspace-label { display: flex; align-items: center; gap: 9px; margin: 0 0 16px; color: #cbd5ec; font-size: 12px; }
  .problem-workspace-label > span { width: 6px; height: 6px; border-radius: 50%; background: #64d6f2; }
  .problem-workspace h3 { max-width: 21ch; margin: 0; font-size: clamp(27px, 2.5vw, 40px); line-height: 1.1; letter-spacing: -.035em; color: #fff; }
  .problem-fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin: 24px 0; padding: 20px 0; border-block: 1px solid #ffffff29; }
  .problem-fields dt { margin-bottom: 7px; color: #b8c4d9; font-size: 11px; font-weight: 400; line-height: 1.4; }
  .problem-fields dd { margin: 0; color: #fff; font-size: 14px; line-height: 1.45; }
  .problem-assistance { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 16px; }
  .problem-assistance > p { max-width: 17ch; margin: 0; color: #cbd5ec; font-size: 13px; line-height: 1.5; }
  .problem-assistance li { display: flex; align-items: baseline; gap: 8px; margin-bottom: 7px; font-size: 13px; line-height: 1.45; }
  .problem-assistance li:last-child { margin-bottom: 0; }
  .problem-assistance svg { flex: none; width: 14px; height: 14px; color: #64d6f2; }
  .problem-decision { margin: 22px 0 0; font-size: 12px; line-height: 1.5; color: #b8c4d9; }
  .problem-map figcaption { grid-column: 1 / -1; margin-top: 18px; color: var(--renoir-muted); font-size: 11px; line-height: 1.5; }
  .problem-bottom { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin-top: 24px; }
  .problem-proof { display: inline-flex; align-items: center; gap: 16px; min-width: 0; padding: 4px; border-radius: 8px; color: var(--renoir-ink); }
  .problem-proof img { flex: none; width: 120px; height: auto; border: 1px solid var(--renoir-line); border-radius: 6px; }
  .problem-proof small { display: block; margin-bottom: 4px; color: var(--renoir-muted); font-size: 11px; }
  .problem-proof strong { display: block; font-size: 14px; font-weight: 500; line-height: 1.5; }
  .problem-proof strong span { color: var(--renoir-accent); }
  .problem-service-link { min-height: 44px; flex: none; align-items: center; }
  .problem-proof:focus-visible, .problem-service-link:focus-visible { outline: 2px solid var(--renoir-accent); outline-offset: 4px; }
  .problem-proof:hover strong { color: var(--renoir-accent); }
  @media (max-width: 991px) {
    .problem-heading { grid-template-columns: 1fr; gap: 20px; }
    .problem-intro { max-width: 60ch; }
    .problem-map { grid-template-columns: minmax(190px, .85fr) 48px minmax(0, 1.15fr); padding: 24px; }
    .problem-connector { width: 48px; }
    .problem-workspace { padding: 24px; }
    .problem-sources li { padding-inline: 12px; gap: 10px; }
    .problem-assistance { grid-template-columns: 1fr; gap: 10px; }
    .problem-assistance > p { max-width: none; }
  }
  @media (max-width: 767px) {
    .home-problem { padding: 56px 0; }
    .problem-heading { gap: 18px; margin-bottom: 24px; }
    .problem-heading h2 { font-size: clamp(30px, 7.6vw, 42px); }
    .problem-heading .home-section-label { margin-bottom: 16px; }
    .problem-intro { font-size: 15px; }
    .problem-map { grid-template-columns: 1fr; padding: 20px; border-radius: 14px; }
    .problem-sources h3 { font-size: 12px; margin-bottom: 12px; }
    .problem-sources ul { gap: 10px; }
    .problem-sources li { height: auto; min-height: 64px; }
    .problem-sources li > svg { width: 26px; height: 26px; }
    .problem-sources li span { font-size: 11px; margin-bottom: 2px; }
    .problem-sources li p { font-size: 14px; }
    .problem-connector { display: none; }
    .problem-connector-mobile { display: block; width: 32px; height: 44px; margin: 0 auto; color: var(--renoir-accent); }
    .problem-workspace { padding: 24px 20px; }
    .problem-workspace h3 { font-size: 29px; }
    .problem-fields { gap: 12px; margin-block: 20px; padding-block: 16px; }
    .problem-fields dt { font-size: 10px; }
    .problem-fields dd { font-size: 12px; }
    .problem-assistance { gap: 12px; }
    .problem-assistance ul { display: grid; gap: 6px; }
    .problem-assistance li { margin: 0; }
    .problem-map figcaption { margin-top: 16px; font-size: 10px; }
    .problem-bottom { align-items: flex-start; flex-direction: column; gap: 20px; }
    .problem-proof { gap: 12px; }
    .problem-proof img { width: 96px; }
    .problem-proof strong { font-size: 13px; }
  }
</style>
