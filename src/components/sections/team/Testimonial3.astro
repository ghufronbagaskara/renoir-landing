               </div>
           </div>
           <div class="col-lg-8">
               <div class="si-testimonial-3-main2">
               <div class="swiper-testimonial-3 swiper">
                   <div class="swiper-wrapper">
                       <div class="swiper-slide">
                           <div class="si-testimonial-3-box2">
                               <div class="si-testimonial-3-icon">
