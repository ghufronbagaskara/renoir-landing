---
import Img from "~/components/ui/Img.astro";
import { imageUrls } from "~/lib/images";
const img = await imageUrls(["testimonial/bg2.jpg","testimonial/bg3.jpg"]);
---
<section class="si-testimonial-3-area pt-124 pb-124" style={`background-image:url(${img["testimonial/bg2.jpg"]})`}>
   <div class="container container-1617">
       <div class="row">
           <div class="col-lg-12">
               <div class="si-testimonial-3-main">
                   <div class="si-section-title pb-38">
                       <span>our success case study</span>
                       <h2 class="si-text-revel-anim">Testimonials From <br class="d-none d-xxl-block"> Our Customers</h2>
                   </div>
                   <div class="si-testimonial-3-navigation">
                       <div class="si-button-next navigation-icon2" aria-label="Previous testimonial">
                           <a class="no-href" role="button" tabindex="0"><Img src="testimonial/left.svg" alt="" /></a>
                       </div>
                       <div class="si-button-prev navigation-icon2" aria-label="Next testimonial">
                           <a class="no-href" role="button" tabindex="0"><Img src="testimonial/right.svg" alt="" /></a>
                       </div>
                   </div>
               </div>
           </div>
           <div class="col-lg-4">
               <div class="si-testimonial-3-box" style={`background-image:url(${img["testimonial/bg3.jpg"]})`}>
