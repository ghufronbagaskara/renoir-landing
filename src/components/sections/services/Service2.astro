---
import { getServices } from "~/lib/content";

const services = await getServices();
---
<section class="si-service-2-area pb-70 pt-124">
  <div class="container container-1617">
    <div class="row">
      <div class="col-lg-12">
        <div class="si-service-2-main pb-20">
          <div class="si-section-title">
            <span>our service</span>
            <h2 class="si-text-revel-anim">We Build Your Digital <br class="d-none d-xxl-block" /> Business.</h2>
          </div>
          <div class="si-service-2-btn">
            <a class="si-btn-one black-bg-btn border-btn" href="/portfolio/"> <span class="btn-text"><span> View Our Works</span> </span> <span class="btn-icon btn-icon2"><i class="fa-sharp fa-regular fa-arrow-right"></i></span></a>
          </div>
        </div>
        {
          services.map((s, i) => {
            const number = String(i + 1).padStart(3, "0");
            const title = (
              <div class:list={["si-service-2-text", { "service-2-right": i % 2 === 1 }]}>
                <span>{number}</span>
                <h3><a href={`/services/${s.id}/`}>{s.data.title}</a></h3>
              </div>
            );
            const text = (
              <div class:list={["si-service-2-p", { "service-2-left": i % 2 === 1 }]}>
                <p>{s.data.excerpt}</p>
              </div>
            );
            return <div class="si-service-2-box">{i % 2 === 1 ? [text, title] : [title, text]}</div>;
          })
        }
      </div>
    </div>
  </div>
</section>
