---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Img from "~/components/ui/Img.astro";
import NotesSidebar from "~/components/sections/notes/NotesSidebar.astro";
import { child, otherLocale, path, t, type Alternates, type Locale } from "~/i18n";
import { formatDate, getNoteTranslation, noteSlug } from "~/lib/content";
import { abs, articleNode } from "~/lib/seo";
import { imageUrl } from "~/lib/images";

interface Props {
  locale: Locale;
  entry: CollectionEntry<"notes">;
}
const { locale, entry } = Astro.props;
const c = t(locale);
const n = c.notes;
const note = entry.data;
const url = child("notes", locale, noteSlug(entry));
const translation = await getNoteTranslation(entry, otherLocale(locale));
const alternates: Alternates = { [locale]: url };
if (translation) alternates[otherLocale(locale)] = child("notes", otherLocale(locale), noteSlug(translation));
const { Content } = await render(entry);

const shareUrl = encodeURIComponent(abs(url));
const shareTitle = encodeURIComponent(note.title);
const share = [
  ["blog-details/icon2.svg", `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`, "Facebook"],
  ["blog-details/icon3.svg", `https://x.com/intent/post?url=${shareUrl}&text=${shareTitle}`, "X"],
  ["blog-details/icon4.svg", `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`, "LinkedIn"],
  ["blog-details/icon5.svg", `https://wa.me/?text=${shareTitle}%20${shareUrl}`, "WhatsApp"],
];
---
<BaseLayout
  locale={locale}
  title={`${note.title} | ${c.site.name}`}
  description={note.description}
  alternates={alternates}
  breadcrumb={{ title: note.title, parent: { label: n.breadcrumb, href: path("notes", locale) } }}
  ogType="article"
  schema={[articleNode({ url, title: note.title, description: note.description, date: note.date, image: imageUrl(note.image), locale })]}
>
  <section class="si-blog-details-area pt-127 pb-127">
    <div class="container container-1617">
      <div class="row">
        <article class="col-lg-8">
          <div class="si-blog-details-thumb">
            <Img src={note.image} alt="" loading="eager" />
          </div>
          <div class="si-blog-details-text">
            <span>{note.category}</span>
            <span><time datetime={note.date.toISOString().slice(0, 10)}>{formatDate(note.date, locale)}</time></span>
            <span>{n.by} {c.site.name}</span>
            <p class="h3 note-lead">{note.description}</p>
          </div>
          <div class="note-body">
            <Content />
          </div>
          <div class="si-blog-details-list-main">
            <div class="si-blog-details-list">
              <span>{n.share}</span>
            </div>
            <div class="si-blog-details-list2">
              <ul>
                {
                  share.map(([icon, href, label]) => (
                    <li>
                      <a href={href} aria-label={`${n.share}: ${label}`} rel="noopener" target="_blank">
                        <Img src={icon} alt="" />
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </article>
        <div class="col-lg-4">
          <NotesSidebar locale={locale} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
