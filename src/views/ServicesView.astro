---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ServiceList from "~/components/sections/services/ServiceList.astro";
import Engagements from "~/components/sections/shared/Engagements.astro";
import { child, routeAlternates, t, type Locale } from "~/i18n";
import { getServices, serviceCopy } from "~/lib/content";
import { serviceNode } from "~/lib/seo";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale).services;
const services = await getServices();
const schema = services.map((entry) => {
  const copy = serviceCopy(entry, locale);
  return serviceNode({ name: copy.title, description: copy.metaDescription, url: child("services", locale, copy.slug), locale });
});
---
<BaseLayout
  locale={locale}
  title={s.metaTitle}
  description={s.metaDescription}
  alternates={routeAlternates("services")}
  breadcrumb={{ title: s.breadcrumb }}
  pageType="CollectionPage"
  schema={schema}
>
  <ServiceList locale={locale} />
  <Engagements locale={locale} variant="services" />
</BaseLayout>
