# Copy to .env (git-ignored). Read by alchemy.run.ts via effect/Config at deploy time.
# Cloudflare credentials are NOT set here — Alchemy uses profiles (~/.alchemy/profiles.json);
# the first `bun alchemy deploy` prompts for OAuth or an API token.

# Required: your account's workers.dev subdomain, e.g. "yourname.workers.dev".
# Used as the Turnstile widget's allowed domain (covers every stage's *.workers.dev URL).
WORKERS_DEV_SUBDOMAIN=

# Lead sinks for the contact form (all optional, but configure at least one or the form returns an error).
# Telegram: create a bot with @BotFather, send it a message, read chat.id from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Google Sheet + email via Apps Script web app: see scripts/leads-apps-script.gs.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Only needed for CI previews / stacks/github.ts.
GITHUB_OWNER=
GITHUB_REPO=
